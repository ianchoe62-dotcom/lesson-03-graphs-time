import pandas as pd
import plotly.express as px

# 1. 영화별 총 관객 수 및 10위권 진입 일수 집계
df_top10 = (
    df.groupby('movie_name')
    .agg(
        total_audience=('daily_audience', 'sum'),
        top10_days=('rank', lambda x: (x <= 10).sum()),  # 10위권 내에 든 날수 계산
    )
    .reset_index()
    .sort_values(by='total_audience', ascending=False)
    .head(10)
)

# 2. Plotly 가로 막대그래프 축 순서 맞춤 (상단에 관객 수 최다 영화 배치)
# Plotly y축은 아래에서 위로 그려지므로 오름차순 정렬해야 가장 큰 값이 위에 위치합니다.
df_chart = df_top10.sort_values(by='total_audience', ascending=True)

# 3. 가로 막대그래프 생성
fig = px.bar(
    df_chart,
    x='total_audience',
    y='movie_name',
    orientation='h',
    custom_data=['top10_days'],
    title='<b>기간 내 영화별 누적 관객 수 TOP 10</b>',
    labels={'total_audience': '총 관객 수(명)', 'movie_name': '영화명'},
)

# 4. 호버(마우스 오버) 툴팁 및 디자인 설정
fig.update_traces(
    hovertemplate="<b>%{y}</b><br>"
    + "총 관객 수: %{x:,}명<br>"
    + "10위권 유지 일수: %{customdata[0]}일"
    + "<extra></extra>"
)

fig.update_layout(
    xaxis_title='총 관객 수 (명)',
    yaxis_title=None,
    template='plotly_white',
    height=500,
)

fig.show()
import pandas as pd
import plotly.express as px

# 1. 날짜 데이터 변환 및 월, 요일 추출
df['date'] = pd.to_datetime(df['date'])
df['month'] = df['date'].dt.strftime('%m월')

# 월요일(0) ~ 일요일(6) 순서 정의
weekday_order = ['월요일', '화요일', '수요일', '목요일', '금요일', '토요일', '일요일']
df['weekday'] = df['date'].dt.weekday.map(lambda x: weekday_order[x])

# 2. 월 × 요일 피벗 테이블 생성 (총 관객 수 합계)
pivot_df = df.pivot_table(
    index='month',
    columns='weekday',
    values='daily_audience',
    aggfunc='sum',
    fill_value=0,
)

# 3. 요일 순서를 월요일~일요일로 정렬
pivot_df = pivot_df.reindex(columns=weekday_order)

# 4. 히트맵 그래프 생성
fig = px.imshow(
    pivot_df,
    labels=dict(x='요일', y='월', color='총 관객 수'),
    x=pivot_df.columns,
    y=pivot_df.index,
    color_continuous_scale='Reds',  # 진할수록 관객 수가 많음을 표현 (Blues, Viridis 등 변경 가능)
    title='<b>월 × 요일별 일관객 합계 히트맵</b>',
    aspect='auto',
)

# 5. 호버(마우스 오버) 툴팁 및 레이아웃 설정
fig.update_traces(
    hovertemplate='<b>%{y} %{x}</b><br>총 관객 수: %{z:,}명<extra></extra>'
)

fig.update_layout(
    xaxis_title='요일',
    yaxis_title='월',
    template='plotly_white',
    height=450,
)

fig.show()
