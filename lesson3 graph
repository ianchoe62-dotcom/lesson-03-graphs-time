import pandas as pd
import plotly.express as px

# 1. 영화별 총 관객 수 및 10위권 진입 일수 집계
df_top10 = (
    df.groupby('movie_name')
    .agg(
        total_audience=('daily_audience', 'sum'),
        top10_days=('rank', lambda x: (x <= 10).sum()),  # 10위권 내에 든 날수 계산
    )
    .reset_index()
    .sort_values(by='total_audience', ascending=False)
    .head(10)
)

# 2. Plotly 가로 막대그래프 축 순서 맞춤 (상단에 관객 수 최다 영화 배치)
# Plotly y축은 아래에서 위로 그려지므로 오름차순 정렬해야 가장 큰 값이 위에 위치합니다.
df_chart = df_top10.sort_values(by='total_audience', ascending=True)

# 3. 가로 막대그래프 생성
fig = px.bar(
    df_chart,
    x='total_audience',
    y='movie_name',
    orientation='h',
    custom_data=['top10_days'],
    title='<b>기간 내 영화별 누적 관객 수 TOP 10</b>',
    labels={'total_audience': '총 관객 수(명)', 'movie_name': '영화명'},
)

# 4. 호버(마우스 오버) 툴팁 및 디자인 설정
fig.update_traces(
    hovertemplate="<b>%{y}</b><br>"
    + "총 관객 수: %{x:,}명<br>"
    + "10위권 유지 일수: %{customdata[0]}일"
    + "<extra></extra>"
)

fig.update_layout(
    xaxis_title='총 관객 수 (명)',
    yaxis_title=None,
    template='plotly_white',
    height=500,
)

fig.show()
